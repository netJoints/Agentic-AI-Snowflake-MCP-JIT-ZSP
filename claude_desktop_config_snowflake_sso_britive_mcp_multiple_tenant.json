{
  "mcpServers": {
    "britive-tenant-1": {
      "command": "/Users/username/Britive_MCP_Server/venv/bin/python",
      "args": [
        "/Users/username/Britive_MCP_Server/britive_mcp_tools/core/mcp_runner.py"
      ],
      "env": {
        "PYTHONPATH": "/Users/username/Britive_MCP_Server",
        "BRITIVE_TENANT": "tenant-1"
      }
    },
    "britive-tenant-2": {
      "command": "/Users/username/Britive_MCP_Server/venv/bin/python",
      "args": [
        "/Users/username/Britive_MCP_Server/britive_mcp_tools/core/mcp_runner.py"
      ],
      "env": {
        "PYTHONPATH": "/Users/username/Britive_MCP_Server",
        "BRITIVE_TENANT": "tenant-2"
      }
    },
    "snowflake": {
      "command": "uvx",
      "args": [
        "--python=3.12.2",
        "--with=pyOpenSSL==24.2.1",
        "--with=cryptography==43.0.1",
        "mcp_snowflake_server",
        "--account",
        "ABCDEFG-ABC12345",
        "--user",
        "username@example.com",
        "--warehouse",
        "DEMO_COMPUTE_WH",
        "--database",
        "SNOWFLAKE_SAMPLE_DATA",
        "--schema",
        "PUBLIC",
        "--role",
        "PUBLIC",
        "--log_level",
        "DEBUG"
      ],
      "env": {
        "SNOWFLAKE_AUTHENTICATOR": "externalbrowser"
      }
    }
  },
  "preferences": {
    "chromeExtensionEnabled": false,
    "quickEntryShortcut": "off",
    "coworkScheduledTasksEnabled": false,
    "sidebarMode": "chat"
  }
}
